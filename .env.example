# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- Contact form (EmailJS) ---
# EmailJS is a client-side service: its service/template IDs and Public key are
# delivered to the browser BY DESIGN and are not secret. Restrict the template's
# "Allowed Origins" in the EmailJS dashboard to your production domain.
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=

# --- Google Analytics (GA4) ---
# Set to your GA4 measurement ID (e.g. G-XXXXXXXXXX). The gtag loader in
# src/main.jsx only initialises when this is present, so local/SSR stays clean.
VITE_GA_ID=

# --- Site URL ---
# Public origin used for canonical URLs, og:image and the sitemap.
VITE_SITE_URL=https://pranaypatle.dev
